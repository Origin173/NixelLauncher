{
  "name": "nixellauncher",
  "version": "0.1.0",
  "description": "A local-first Minecraft Java Edition launcher",
  "author": "NixelLauncher contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --dir --publish never",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "cordis": "4.0.0-rc.12",
    "dompurify": "^3.4.17",
    "i18next": "^26.7.1",
    "marked": "^18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.11",
    "undici": "8.12.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
