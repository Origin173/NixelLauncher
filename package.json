{
  "name": "nixellauncher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
