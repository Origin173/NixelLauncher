# Microsoft public client ID with device-code flow and Minecraft service access.
MICROSOFT_CLIENT_ID=

# CurseForge API key. Quotes preserve characters such as $ and #.
CURSEFORGE_API_KEY=""

# Optional: public Modrinth search and downloads also work without a token.
MODRINTH_TOKEN=""

# Optional public generic electron-updater feed directory and manual release page (HTTPS).
# Leave empty until real release metadata and signed platform artifacts are published.
NIXEL_UPDATE_FEED_URL=
NIXEL_UPDATE_RELEASE_URL=
# Windows: expected public Authenticode certificate publisher name (not a signing key).
NIXEL_UPDATE_PUBLISHER=

# Optional absolute path for an isolated launcher data directory.
# NIXEL_DATA_DIR=D:/Code/NixelLauncher/output/local-data
